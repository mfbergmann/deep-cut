# Copy to .env and fill in.
RADARR_API_KEY=
RADARR_URL=http://radarr:7878
CONFIG_DIR=./config
MEDIA_DIR=/path/to/data          # mounted at /data, exactly as Radarr mounts it
TZ=UTC
# Optional
VIMEO_TOKEN=                     # developer.vimeo.com personal token, "public" scope
INBOX_SHARE=                     # how the inbox is reached from your desktop, shown on the page
